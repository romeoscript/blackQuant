# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo

# KYC uploads written by the dev fallback when no object store is configured
.uploads/

# Face-detection model weights, staged from node_modules by scripts/copy-face-models.mjs
public/models/

# Video masters downloaded by scripts/upload-videos.mjs on their way to Cloudinary
.cache/
