// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int       @id @default(autoincrement())
  name              String?
  email             String    @unique
  emailVerified     DateTime?
  /// Written by the OAuth provider — an absolute URL to their avatar.
  image             String?
  /// Object-store key for a picture the user uploaded themselves. Kept apart
  /// from `image` so the adapter can keep owning that column, and so the two
  /// can be told apart: this one is a key, never a URL. Takes precedence.
  avatarKey         String?
  /// Null for accounts created purely through an OAuth provider.
  passwordHash      String?
  /// Stamped on every password change so the profile can age it honestly.
  /// Null means "never changed since signup".
  passwordChangedAt DateTime?

  username String? @unique
  phone    String?
  country  String?
  currency String  @default("USD")

  /// The code in this account's referral link. Assigned once and never changed:
  /// a link already shared has to keep resolving to the same account. Null on
  /// accounts made before the programme existed; minted on first read.
  referralCode String? @unique
  /// Who referred this account. Written with the account row and never
  /// afterwards — signup is the only moment attribution cannot be argued with,
  /// and a mutable column would let commission be re-pointed after it was
  /// earned. Set-null rather than cascade on delete: losing a referrer must not
  /// delete the people they referred.
  referredById Int?
  referredBy   User?   @relation("Referral", fields: [referredById], references: [id], onDelete: SetNull)
  referrals    User[]  @relation("Referral")

  /// Spendable balance in USD. A cache of `sum(ledgerEntries.amountUsd)`, and
  /// only ever written in the same transaction as the entry that explains it,
  /// so the two cannot drift. Read this; audit against the ledger.
  balanceUsd Decimal @default(0) @db.Decimal(18, 2)

  notifySignals     Boolean @default(true)
  notifyPositions   Boolean @default(true)
  notifyWithdrawals Boolean @default(true)
  notifyReferrals   Boolean @default(false)

  /// AES-256-GCM ciphertext — never the raw TOTP secret. Present without
  /// `twoFactorEnabledAt` means an enrollment was started but never confirmed.
  twoFactorSecret    String?
  twoFactorEnabledAt DateTime?

  accounts         Account[]
  sessions         Session[]
  recoveryCodes    RecoveryCode[]
  kycSubmissions   KycSubmission[]
  passwordResets   PasswordResetToken[]
  credentialResets CredentialResetCode[]
  notifications    Notification[]
  depositAddresses DepositAddress[]
  depositEvents    DepositEvent[]
  ledgerEntries    LedgerEntry[]
  purchases        Purchase[]
  paymentIntents   PaymentIntent[]

  commissionsEarned ReferralCommission[] @relation("CommissionEarner")
  commissionsGiven  ReferralCommission[] @relation("CommissionSource")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The downline lookup: everyone one account referred.
  @@index([referredById])
}

model Account {
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([provider, providerAccountId])
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscriber {
  id     Int    @id @default(autoincrement())
  email  String @unique
  source String @default("luminary-circle")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Required by the Auth.js Prisma adapter. Unused today — no email provider is
/// configured — but the adapter contract expects the table to exist.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

/// Single-use password reset grant. Only the SHA-256 of the token is stored, so
/// a database leak cannot be replayed against the reset endpoint.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

/// Single-use escape hatch when the authenticator is lost. Stored as digests,
/// so the table alone cannot be used to sign in.
model RecoveryCode {
  id       Int       @id @default(autoincrement())
  userId   Int
  codeHash String
  usedAt   DateTime?
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

/// Step-up check for changing credentials from inside an authenticated session.
/// Six digits is only ~1M wide, so `attempts` is load-bearing: without a cap the
/// code is brute-forceable well inside its lifetime.
model CredentialResetCode {
  id        Int       @id @default(autoincrement())
  /// Deliberately not unique: six digits collide across users often enough to
  /// fail a legitimate request. Rows are found by `userId` — which is also what
  /// makes `attempts` enforceable, since a wrong guess must still land on the
  /// user's own row to be counted.
  codeHash  String
  userId    Int
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum KycDocumentKind {
  DOCUMENT_FRONT
  DOCUMENT_BACK
  SELFIE
}

/// One identity-verification attempt. The account's overall status is derived
/// from the newest row rather than denormalised onto `User`, so the two can
/// never disagree.
model KycSubmission {
  id                Int           @id @default(autoincrement())
  userId            Int
  status            KycStatus     @default(PENDING)
  /// Which document the user chose: "id" | "passport" | "licence".
  documentType      String
  /// True only when the simulated liveness step was completed. Named for what
  /// it is — no anti-spoofing is performed, so it proves presence of a capture,
  /// not presence of a person.
  livenessSimulated Boolean       @default(false)
  reviewedAt        DateTime?
  reviewNote        String?
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents         KycDocument[]

  createdAt DateTime @default(now())

  /// The screen always reads one user's attempts newest-first.
  @@index([userId, createdAt])
}

/// Pointer to an object in private storage. The bytes never touch this table.
model KycDocument {
  id           Int             @id @default(autoincrement())
  submissionId Int
  kind         KycDocumentKind
  /// Object key within the bucket; never a public URL.
  storageKey   String
  contentType  String
  byteSize     Int
  submission   KycSubmission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([submissionId])
}

/// Drives the icon and tone each notification renders with.
enum NotificationKind {
  WELCOME
  SECURITY
  SYSTEM
}

/// In-app notification. Read state is a nullable timestamp rather than a
/// boolean so "when was this read" is answerable without a second column.
model Notification {
  id     Int              @id @default(autoincrement())
  userId Int
  kind   NotificationKind @default(SYSTEM)
  title  String
  body   String
  readAt DateTime?
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  /// The panel always reads one user's rows newest-first.
  @@index([userId, createdAt])
}

/// Where a deposit got to. `CONFIRMED` is the only status that has moved money
/// into a balance; everything else is informational.
enum DepositStatus {
  WAITING
  CONFIRMING
  CONFIRMED
  PARTIALLY_PAID
  FAILED
  EXPIRED
}

/// A payin address minted by NOWPayments and handed to one user for one chain.
///
/// We do not hold its keys — it is a routing tag whose only job is to say who
/// sent the funds, which then forward to a treasury wallet we do hold. It
/// persists for the life of the account, so a user's saved address keeps
/// working.
model DepositAddress {
  id          Int      @id @default(autoincrement())
  userId      Int
  /// NOWPayments currency code, e.g. "usdttrc20".
  currency    String
  address     String
  /// Destination tag / memo. Set only on chains where NOWPayments hands every
  /// user the *same* address and distinguishes them by tag (XRP); null
  /// everywhere else. Part of this address's identity, never decoration — a
  /// callback is matched on the pair, because matching on a shared address
  /// alone would credit an arbitrary user.
  extraId     String?
  /// The payment whose creation minted the address, kept for support.
  npPaymentId String
  /// Smallest accepted deposit, as NOWPayments reported it when the address was
  /// minted. Shown on the deposit screen so the figure is a real one — refresh
  /// it if the network minimum moves.
  minAmount   Decimal? @db.Decimal(38, 18)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, currency])
  /// The lookup the IPN handler performs, on both columns together.
  @@index([address, extraId])
}

/// One row per NOWPayments payment, updated in place as the deposit progresses.
///
/// Deliberately not one row per callback: NOWPayments sends `confirming`
/// repeatedly as confirmations accumulate, and the UI shows a single deposit
/// with a status, not a log. Crediting is made idempotent by the unique
/// constraint on `LedgerEntry`, not by rejecting repeat callbacks here.
model DepositEvent {
  id              Int           @id @default(autoincrement())
  userId          Int
  currency        String
  /// Crypto actually received, in `currency`.
  payAmount       Decimal       @db.Decimal(38, 18)
  /// What NOWPayments forwarded to the treasury, in `outcomeCurrency`. Only
  /// dollar-denominated when auto-conversion is configured — which is exactly
  /// what `heldReason` exists to catch.
  outcomeAmount   Decimal?      @db.Decimal(38, 18)
  outcomeCurrency String?
  /// What actually reached the balance. Zero until confirmed.
  usdCredited     Decimal       @default(0) @db.Decimal(18, 2)
  confirmations   Int           @default(0)
  txHash          String?
  status          DepositStatus
  npPaymentId     String        @unique
  /// Set when a callback confirmed but was deliberately not credited. A row
  /// with this set needs a human — it is never a state the user can resolve.
  heldReason      String?
  /// The full callback body. When someone disputes an amount six months from
  /// now, the fee breakdown in here settles it.
  rawPayload      Json

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

/// Append-only record of every balance change, with what caused it.
///
/// `balanceUsd` is derived from these. Nothing writes a balance without writing
/// the entry that explains it, in the same transaction.
model LedgerEntry {
  id        Int     @id @default(autoincrement())
  userId    Int
  /// Signed: credits positive, debits negative.
  amountUsd Decimal @db.Decimal(18, 2)
  /// "deposit" | "purchase" | "withdrawal" | "adjustment".
  kind      String
  /// The row that caused it — a DepositEvent id, an order id, and so on.
  refId     String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  /// The idempotency guard for the whole system. A replayed IPN callback fails
  /// here, which is the one write that must happen exactly once.
  @@unique([kind, refId])
  @@index([userId, createdAt])
}

/// Something bought from the store, and the record that it was paid for.
///
/// The price is stored as charged rather than read back from the catalogue: a
/// receipt has to survive the catalogue changing.
model Purchase {
  id        Int       @id @default(autoincrement())
  userId    Int
  /// Catalogue id from `lib/store.ts`.
  itemId    String
  priceUsd  Decimal   @db.Decimal(18, 2)
  /// When a subscription lapses. Null for a one-time add-on, which is kept
  /// forever — the absence of a date is what makes it permanent.
  expiresAt DateTime?

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  commissions ReferralCommission[]

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// Commission one account earned from another account's purchase.
///
/// The ledger already records the credit — this exists because the ledger
/// cannot answer "how much has this particular referral earned me", which is
/// the question the Referral Hub is built around. Written in the same
/// transaction as the entry that pays it, so the two cannot disagree.
model ReferralCommission {
  id           Int     @id @default(autoincrement())
  /// Who was paid.
  earnerId     Int
  /// Whose purchase paid them.
  sourceUserId Int
  purchaseId   Int
  /// 1 for the direct referrer, 2 for the referrer above them.
  tier         Int
  /// The rate as applied, in basis points. Frozen for the same reason
  /// `Purchase.priceUsd` is: changing the programme must not silently rewrite
  /// what someone has already earned.
  rateBps      Int
  amountUsd    Decimal @db.Decimal(18, 2)

  earner     User     @relation("CommissionEarner", fields: [earnerId], references: [id], onDelete: Cascade)
  sourceUser User     @relation("CommissionSource", fields: [sourceUserId], references: [id], onDelete: Cascade)
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  /// One award per purchase per tier, whichever route the purchase arrived by.
  /// The matching guard on the money itself is `LedgerEntry`'s unique
  /// `(kind, refId)`; this one keeps the record that explains it just as single.
  @@unique([purchaseId, tier])
  /// The Hub reads one earner's commissions newest-first, and sums them per
  /// referred user.
  @@index([earnerId, createdAt])
  @@index([earnerId, sourceUserId])
}

/// A crypto payment raised for one catalogue item, rather than a top-up.
///
/// The callback for it arrives at an address that belongs to no `DepositAddress`
/// row, so this is what tells the IPN handler whose it is and what it buys. The
/// price is captured here because the catalogue may change before it settles.
model PaymentIntent {
  id          Int       @id @default(autoincrement())
  userId      Int
  itemId      String
  priceUsd    Decimal   @db.Decimal(18, 2)
  /// The NOWPayments payment this intent is settled by.
  npPaymentId String    @unique
  payAddress  String
  /// Destination tag, on the chains that share an address.
  payExtraId  String?
  /// Crypto the customer chose to pay in, as a NOWPayments code.
  payCurrency String
  /// Set once the deposit behind it credited and the item was granted, so a
  /// replayed callback cannot buy the same thing twice.
  fulfilledAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
