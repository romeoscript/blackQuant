# Postgres connection string (Neon, Prisma Postgres, Supabase, local, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/blackquant?sslmode=require"

# Generate with: npx auth secret
AUTH_SECRET=""

# Absolute origin of this deployment. Used to build links in outgoing mail.
AUTH_URL="http://localhost:3000"

# GitHub OAuth app credentials (https://github.com/settings/developers)
# Authorized callback URL: $AUTH_URL/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Google OAuth client (https://console.cloud.google.com/apis/credentials)
# Create an "OAuth client ID" of type "Web application", then add
#   Authorized JavaScript origin:  $AUTH_URL
#   Authorized redirect URI:       $AUTH_URL/api/auth/callback/google
# The Google button only appears once AUTH_GOOGLE_ID is set.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Password-reset email. Without a key the reset link is printed to the server
# log instead of being delivered, which is enough to use the flow locally.
# Key: https://resend.com/api-keys
RESEND_API_KEY=""
# Required whenever RESEND_API_KEY is set. Must be on a domain you have
# verified with Resend, or the send is rejected.
RESEND_FROM="BlackQuant <onboarding@resend.dev>"

# Help Desk assistant — any OpenAI-compatible provider.
# Default is OpenRouter with a cheap vision model so screenshots work out of the box.
# OpenRouter key: https://openrouter.ai/keys
ASSISTANT_API_KEY=""
# Optional — switch providers/models without code changes (defaults shown):
#   ASSISTANT_BASE_URL="https://openrouter.ai/api/v1"
#     DeepSeek (text only): https://api.deepseek.com · Groq: https://api.groq.com/openai/v1 · Ollama: http://localhost:11434/v1
#   ASSISTANT_MODEL="google/gemini-2.5-flash"
#     other vision models: qwen/qwen2.5-vl-72b-instruct · free: google/gemma-4-26b-a4b-it:free
#     browse valid slugs: https://openrouter.ai/models?fmt=table&input_modalities=image
#     text-only + cheapest: deepseek-chat (set ASSISTANT_BASE_URL to DeepSeek; images will be ignored)
#   ASSISTANT_EMBED_MODEL="openai/text-embedding-3-small"   # for the knowledge base (RAG); ~$0.02/1M tokens
#     Feed company data: put .md files in content/knowledge/, then run `npm run ingest`.

# Private object storage for KYC documents. Any S3-compatible endpoint works:
# AWS S3, Cloudflare R2, Backblaze B2, MinIO. Without these, uploads fall back
# to a local .uploads/ directory that is development-only and unencrypted.
#
# For local development:
#   brew install minio minio-mc
#   (fill in the values below, choosing your own secret)
#   npm run minio
#   mc alias set bqlocal http://127.0.0.1:9000 <key-id> <secret>
#   mc mb bqlocal/blackquant-kyc
S3_ENDPOINT="http://127.0.0.1:9000"
S3_REGION="us-east-1"
S3_BUCKET="blackquant-kyc"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Crypto deposits through NOWPayments. Without NOWPAYMENTS_API_KEY the deposit
# page reports that deposits aren't available and no addresses are minted.
#
# The IPN secret is what stands between this app and an unauthenticated
# "credit this account" endpoint — it is validated at boot alongside the key,
# because an API key without it hands out addresses whose callbacks can never
# be trusted.
#
# NOTE: the account must be configured to auto-convert incoming assets to a
# stablecoin. Without it, callbacks arrive denominated in the deposited asset
# and are held for review rather than credited (see lib/deposit.ts).
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""
NOWPAYMENTS_BASE_URL="https://api-sandbox.nowpayments.io"   # prod: https://api.nowpayments.io

# The dexwatch signal engine — the separate process that watches the trade
# feed, fires signals and measures what they were worth. Without a base URL the
# Signal Engine screen reports that it isn't connected; it never falls back to
# placeholder numbers, because a fabricated win rate is the one thing that
# screen must not show.
#
# The API key is only required when the engine is bound off the loopback
# interface. A local engine accepts writes without one, and a remote engine
# started with no --api-key refuses them outright.
SIGNAL_ENGINE_BASE_URL="http://127.0.0.1:8820"
SIGNAL_ENGINE_API_KEY=""

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
