{
  "name": "blackquant",
  "version": "0.1.0",
  "private": true,
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 128",
    "safari >= 16.4",
    "not dead"
  ],
  "scripts": {
    "predev": "prisma generate && npm run face-models",
    "dev": "next dev --turbopack",
    "prebuild": "npm run build:globe && npm run face-models",
    "build": "next build",
    "build:globe": "node scripts/build-globe-data.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "ingest": "tsx scripts/ingest.ts",
    "ipn": "tsx scripts/ipn.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "minio": "sh scripts/minio.sh",
    "face-models": "node scripts/copy-face-models.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.10.0",
    "@gsap/react": "^2.1.2",
    "@paulmillr/qr": "^0.3.0",
    "@prisma/client": "^6.3.0",
    "@prisma/extension-accelerate": "^1.2.1",
    "@shikijs/rehype": "^4.4.3",
    "@sssxyd/face-liveness-detector": "^0.4.3",
    "@tanstack/react-query": "^5.101.2",
    "@techstark/opencv-js": "^4.12.0-release.1",
    "@vladmandic/human": "^3.3.6",
    "@xyflow/react": "^12.11.2",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "globe.gl": "^2.46.1",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "lucide-react": "^1.24.0",
    "nanoid": "^5.1.6",
    "next": "^16.2.10",
    "next-auth": "5.0.0-beta.31",
    "next-themes": "^0.4.6",
    "openai": "^6.47.0",
    "otpauth": "^9.5.1",
    "radix-ui": "^1.6.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shadcn": "^4.13.0",
    "shiki": "^4.4.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/three": "^0.185.1",
    "@types/topojson-client": "^3.1.5",
    "eslint": "^9.18.0",
    "eslint-config-next": "^16.2.10",
    "h3-js": "^4.5.0",
    "prettier": "^3.4.2",
    "prisma": "^6.3.0",
    "tailwindcss": "^4.3.2",
    "topojson-client": "^3.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10",
    "world-atlas": "^2.0.2"
  }
}
